q1_sentiment <- survey_sentences |>
  filter(question_code == "overall") |>
  group_by(response_id) |>
  summarise(
    has_positive = any(sentence_sentiment == "Positive"),
    has_negative = any(sentence_sentiment == "Negative"),
    .groups = "drop"
  ) |>
  mutate(
    Positive = case_when(
      has_positive & has_negative ~ 0.5,
      has_positive ~ 1,
      TRUE ~ 0
    ),
    Negative = case_when(
      has_positive & has_negative ~ 0.5,
      has_negative ~ 1,
      TRUE ~ 0
    ),
    Neutral = case_when(
      !has_positive & !has_negative ~ 1,
      TRUE ~ 0
    )
  ) |>
  summarise(
    Positive = sum(Positive),
    Negative = sum(Negative),
    Neutral = sum(Neutral)
  ) |>
  pivot_longer(
    everything(),
    names_to = "Sentiment",
    values_to = "Responses"
  ) |>
  mutate(
    Percentage = Responses / sum(Responses)
  ) |>
  arrange(match(Sentiment, c("Positive", "Negative", "Neutral")))



q1_sentiment <- bind_rows(
  q1_sentiment,
  tibble(
    Sentiment = "Total",
    Responses = sum(q1_sentiment$Responses),
    Percentage = 1
  )
)
