q1_sentiment <- response_sentiment_3 |>
  filter(question_code == "overall") |>
  count(classification, name = "Responses") |>
  complete(
    classification = c("Positive", "Negative", "Neutral"),
    fill = list(Responses = 0)
  ) |>
  mutate(
    Percentage = Responses / n_distinct(
      response_sentiment$respondent_id[
        response_sentiment$question_code == "overall"
      ]
    )
  ) |>
  arrange(match(classification, c("Positive", "Negative", "Neutral"))) |>
  rename(Sentiment = classification)

q1_sentiment <- bind_rows(
  q1_sentiment,
  tibble(
    Sentiment = "Total",
    Responses = n_distinct(
      response_sentiment$respondent_id[
        response_sentiment$question_code == "overall"
      ]
    ),
    Percentage = 1
  )
)
