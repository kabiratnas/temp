q1_sentiment <- survey_sentences |>
  filter(question_code == "overall") |>
  group_by(response_id) |>
  summarise(
    has_positive = any(sentence_sentiment == "Positive"),
    has_negative = any(sentence_sentiment == "Negative"),
    .groups = "drop"
  ) |>
  mutate(
    Sentiment = case_when(
      has_positive & has_negative ~ "Positive|Negative",
      has_positive ~ "Positive",
      has_negative ~ "Negative",
      TRUE ~ "Neutral"
    )
  ) |>
  separate_rows(Sentiment, sep = "\\|") |>
  count(Sentiment, name = "Responses") |>
  complete(
    Sentiment = c("Positive", "Negative", "Neutral"),
    fill = list(Responses = 0)
  ) |>
  mutate(
    Percentage = Responses / n_distinct(
      survey_long$response_id[
        survey_long$question_code == "overall"
      ]
    )
  ) |>
  arrange(match(Sentiment, c("Positive", "Negative", "Neutral")))
